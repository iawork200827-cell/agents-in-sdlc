---
import { negocio, ruta, linkWhatsApp, redesActivas } from '../data/negocio';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Oculta el menú y el pie (para la página «un solo link»). */
  sencilla?: boolean;
}

const { titulo, descripcion = `${negocio.nombre}: ${negocio.descripcion.toLowerCase()} en ${negocio.ciudad}.`, sencilla = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${negocio.nombre}` : `${negocio.nombre} · ${negocio.descripcion}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1f4e3d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={sencilla ? 'sencilla' : ''}>
    {
      !sencilla && (
        <header class="nav">
          <div class="wrap nav-inner">
            <a href={ruta()} class="logo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7M5 10v10h14V10M10 20v-6h4v6" /></svg>
              {negocio.nombre}
            </a>
            <nav aria-label="Principal">
              <a href={`${ruta()}#casas`}>Casas</a>
              <a href={`${ruta()}#calendario`}>Calendario</a>
              <a href={`${ruta()}#contacto`}>Contacto</a>
              <a href={linkWhatsApp('Hola, quiero cotizar una casa para mi evento.')} class="btn btn-sm" target="_blank" rel="noopener">
                Cotizar
              </a>
            </nav>
          </div>
        </header>
      )
    }

    <slot />

    {
      !sencilla && (
        <footer class="footer">
          <div class="wrap footer-inner">
            <div>
              <strong>{negocio.nombre}</strong>
              <p>{negocio.descripcion} · {negocio.ciudad}</p>
            </div>
            <div class="footer-links">
              {redesActivas.map(([nombre, url]) => <a href={url} target="_blank" rel="noopener">{nombre}</a>)}
              <a href={ruta('links/')}>Un solo link</a>
            </div>
          </div>
        </footer>
      )
    }

    <a class="wa-flotante" href={linkWhatsApp('Hola, tengo una pregunta sobre las casas para eventos.')} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" /></svg>
    </a>
  </body>
</html>

<style is:global>
  :root {
    --verde: #1f4e3d;
    --verde-claro: #e3ede7;
    --terracota: #b5400f;
    --durazno: #f0c8a8;
    --arena: #e8dccf;
    --crema: #fdf8f2;
    --beige: #f3ebe1;
    --tinta: #231f20;
    --gris: #6b625a;
    --linea: #eadfd2;
    --blanco: #ffffff;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--crema);
    color: var(--tinta);
    font-family: 'DM Sans', system-ui, sans-serif;
    line-height: 1.6;
  }
  h1, h2, h3 { font-family: Lora, Georgia, serif; line-height: 1.15; margin: 0 0 0.4em; }
  a { color: var(--terracota); }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .kicker { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.78rem; font-weight: 700; color: var(--terracota); margin: 0 0 10px; }
  .muted { color: var(--gris); }

  /* Botones */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--terracota); color: #fff; padding: 12px 24px; border-radius: 999px; font: inherit; font-weight: 700; text-decoration: none; border: 0; cursor: pointer; }
  .btn:hover { filter: brightness(1.1); }
  .btn-sm { padding: 8px 18px; }
  .btn-oscuro { background: var(--tinta); }
  .btn-borde { background: var(--blanco); color: var(--tinta); border: 1.5px solid var(--tinta); }
  .btn-block { width: 100%; }

  /* Etiquetas */
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { background: var(--beige); border-radius: 6px; padding: 3px 10px; font-size: 0.82rem; }

  /* Recuadros de color para fotos pendientes */
  .tono-verde { background: var(--verde); color: #fff; }
  .tono-durazno { background: var(--durazno); color: var(--tinta); }
  .tono-arena { background: var(--arena); color: var(--tinta); }

  /* Menú */
  .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--blanco) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--linea); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 12px; }
  .logo { display: inline-flex; align-items: center; gap: 8px; font-family: Lora, serif; font-weight: 700; font-size: 1.3rem; color: var(--tinta); text-decoration: none; }
  .logo svg { width: 24px; height: 24px; fill: none; stroke: var(--terracota); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .nav nav { display: flex; align-items: center; gap: 22px; }
  .nav nav a:not(.btn) { color: var(--tinta); text-decoration: none; font-weight: 500; }
  @media (max-width: 640px) { .nav nav a:not(.btn) { display: none; } }

  /* Secciones */
  .seccion { padding: 72px 0; }
  .seccion-beige { background: var(--beige); }
  .seccion h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .seccion .intro { color: var(--gris); max-width: 60ch; margin: 0 0 32px; font-size: 1.05rem; }

  /* Pie */
  .footer { background: var(--verde); color: #e8efe9; padding: 36px 0; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; }
  .footer p { margin: 4px 0 0; opacity: 0.8; font-size: 0.9rem; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
  .footer-links a { color: #fff; }

  /* Botón flotante de WhatsApp */
  .wa-flotante { position: fixed; right: 18px; bottom: 18px; z-index: 30; width: 56px; height: 56px; border-radius: 50%; background: #25d366; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,0.2); }
  .wa-flotante svg { width: 30px; height: 30px; fill: #fff; }
  .sencilla .wa-flotante { display: none; }
</style>
