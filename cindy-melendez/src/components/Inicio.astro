---
// Paquete 1 · Esencial: página de inicio con catálogo, calendario y cotización.
import Layout from './Layout.astro';
import CasaCard from './CasaCard.astro';
import Calendario from './Calendario.astro';
import { casas, negocio, tiposDeEvento } from '../data/negocio';

const principal = casas[0];
const fotosHero = [principal.fotos[0], ...principal.fotos.slice(1, 3)].filter(Boolean);
---

<Layout>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker" style="color: var(--verde)">{negocio.descripcion}</p>
          <h1>La casa perfecta para tu fiesta, sin complicaciones.</h1>
          <p class="lead">
            Cumpleaños, XV años, baby showers, bodas íntimas y reuniones. Elige la casa, revisa tu fecha y te
            acompañamos hasta el día del evento.
          </p>

          <form class="buscador" id="buscador">
            <label>Fecha<input type="date" name="fecha" /></label>
            <label>
              Evento
              <select name="evento">
                <option value="">Cualquiera</option>
                {tiposDeEvento.map((t) => <option>{t}</option>)}
              </select>
            </label>
            <label>Invitados<input type="number" name="invitados" min="1" placeholder="80" /></label>
            <button class="btn btn-oscuro" type="submit">Buscar</button>
          </form>
          <ul class="ventajas">
            <li>Fechas libres a la vista</li>
            <li>Cotiza en minutos</li>
            <li>Atención por WhatsApp</li>
          </ul>
        </div>

        <div class="hero-fotos" aria-hidden="true">
          {
            fotosHero.map((f, i) => (
              <div class={`hero-foto f${i} tono-${['verde', 'durazno', 'arena'][i]}`}>
                {f.src && <img src={f.src} alt="" />}
                <span>{f.etiqueta}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="casas" class="seccion">
      <div class="wrap">
        <p class="kicker">Catálogo</p>
        <h2>Nuestras casas</h2>
        <p class="intro">Capacidad, lo que incluye, precio y fechas libres. Compara y elige sin tener que preguntar todo por mensaje.</p>

        <div class="filtros" role="group" aria-label="Filtrar casas">
          <button type="button" class="filtro activo" data-evento="">Todas</button>
          {tiposDeEvento.map((t) => <button type="button" class="filtro" data-evento={t}>{t}</button>)}
        </div>

        <div class="grid-casas">
          {casas.map((casa) => <CasaCard casa={casa} />)}
        </div>
        <p class="sin-resultados muted" hidden>Ninguna casa coincide con tu búsqueda. <a href="#contacto">Escríbenos</a> y te ayudamos a encontrar opción.</p>
      </div>
    </section>

    <section id="calendario" class="seccion seccion-beige">
      <div class="wrap cal-layout">
        <div>
          <p class="kicker">Disponibilidad</p>
          <h2>Consulta las fechas libres</h2>
          <p class="intro">Elige la casa y el mes. Toca un día disponible para preguntarnos por él directo por WhatsApp.</p>
        </div>
        <Calendario casas={casas} />
      </div>
    </section>

    <section id="contacto" class="seccion">
      <div class="wrap contacto">
        <div>
          <p class="kicker">Cotización</p>
          <h2>Pide tu cotización</h2>
          <p class="intro">Llena los datos y se abrirá WhatsApp con tu mensaje listo para enviar. Respondemos el mismo día.</p>
          <ul class="datos-contacto">
            <li><span>WhatsApp</span><a href={`https://wa.me/${negocio.whatsapp}`} target="_blank" rel="noopener">{negocio.telefono}</a></li>
            <li><span>Correo</span><a href={`mailto:${negocio.email}`}>{negocio.email}</a></li>
            <li><span>Horario</span>{negocio.horario}</li>
          </ul>
        </div>

        <form class="cotizacion" id="cotizacion" data-whatsapp={negocio.whatsapp}>
          <label>Nombre<input name="nombre" required autocomplete="name" /></label>
          <div class="dos">
            <label>
              Casa
              <select name="casa">
                <option>Aún no sé</option>
                {casas.map((c) => <option>{c.nombre}</option>)}
              </select>
            </label>
            <label>
              Evento
              <select name="evento">
                {tiposDeEvento.map((t) => <option>{t}</option>)}
              </select>
            </label>
          </div>
          <div class="dos">
            <label>Fecha<input type="date" name="fecha" /></label>
            <label>Invitados<input type="number" name="invitados" min="1" /></label>
          </div>
          <label>Comentarios<textarea name="comentarios" rows="3"></textarea></label>
          <button class="btn btn-block" type="submit">Enviar por WhatsApp</button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Filtro del catálogo: por tipo de evento (botones) y por el buscador del inicio.
  const tarjetas = [...document.querySelectorAll<HTMLElement>('.casa-card')];
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.filtro')];
  const vacio = document.querySelector<HTMLElement>('.sin-resultados')!;

  function filtrar(evento: string, invitados = 0) {
    let visibles = 0;
    for (const t of tarjetas) {
      const ok =
        (!evento || (t.dataset.eventos ?? '').split('|').includes(evento)) &&
        (!invitados || Number(t.dataset.capacidad) >= invitados);
      t.hidden = !ok;
      if (ok) visibles++;
    }
    vacio.hidden = visibles > 0;
    botones.forEach((b) => b.classList.toggle('activo', b.dataset.evento === evento));
  }

  botones.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.evento ?? '')));

  document.getElementById('buscador')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    filtrar(String(f.get('evento') ?? ''), Number(f.get('invitados')) || 0);
    document.getElementById('casas')!.scrollIntoView({ behavior: 'smooth' });
  });

  // Cotización: arma el mensaje y abre WhatsApp (en el Paquete 3 se guardará en el panel).
  const form = document.getElementById('cotizacion') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const lineas = [
      `Hola, soy ${f.get('nombre')}. Quiero cotizar un evento:`,
      `• Casa: ${f.get('casa')}`,
      `• Evento: ${f.get('evento')}`,
      f.get('fecha') && `• Fecha: ${f.get('fecha')}`,
      f.get('invitados') && `• Invitados: ${f.get('invitados')}`,
      f.get('comentarios') && `• Comentarios: ${f.get('comentarios')}`,
    ].filter(Boolean);
    window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(lineas.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  .hero { background: var(--blanco); padding: 56px 0 72px; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .lead { font-size: 1.12rem; color: var(--gris); max-width: 54ch; }

  .buscador { display: grid; grid-template-columns: repeat(3, 1fr) auto; gap: 12px; align-items: end; background: var(--blanco); border: 1px solid var(--linea); border-radius: 16px; padding: 14px; box-shadow: 0 10px 30px rgba(35, 31, 32, 0.07); margin-top: 24px; }
  @media (max-width: 560px) { .buscador { grid-template-columns: 1fr 1fr; } .buscador .btn { grid-column: 1 / -1; } }
  .buscador label, .cotizacion label { display: grid; gap: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); }
  .buscador input, .buscador select, .cotizacion input, .cotizacion select, .cotizacion textarea { font: inherit; font-size: 0.95rem; text-transform: none; letter-spacing: 0; color: var(--tinta); padding: 10px 12px; border: 1px solid var(--linea); border-radius: 10px; background: var(--blanco); width: 100%; min-width: 0; }
  .ventajas { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.9rem; color: var(--gris); }
  .ventajas li::before { content: '✓ '; color: var(--verde); font-weight: 700; }

  .hero-fotos { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; height: 440px; }
  @media (max-width: 900px) { .hero-fotos { height: 300px; } }
  .hero-foto { position: relative; border-radius: 18px; overflow: hidden; display: flex; align-items: flex-end; padding: 14px; font-size: 0.88rem; }
  .hero-foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-foto span { position: relative; }
  .hero-foto img + span { background: rgba(0, 0, 0, 0.45); color: #fff; padding: 2px 10px; border-radius: 999px; }
  .f0 { grid-row: 1 / 3; }

  .filtros { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .filtro { font: inherit; font-size: 0.9rem; border: 1px solid var(--linea); background: var(--blanco); border-radius: 999px; padding: 6px 16px; cursor: pointer; }
  .filtro.activo { background: var(--terracota); border-color: var(--terracota); color: #fff; }
  .grid-casas { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }

  .cal-layout { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; }
  @media (max-width: 900px) { .cal-layout { grid-template-columns: 1fr; } }

  .contacto { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: start; }
  @media (max-width: 900px) { .contacto { grid-template-columns: 1fr; } }
  .datos-contacto { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .datos-contacto li { display: grid; }
  .datos-contacto span { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--gris); }
  .cotizacion { background: var(--blanco); border: 1px solid var(--linea); border-radius: 18px; padding: 24px; display: grid; gap: 14px; }
  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
</style>
