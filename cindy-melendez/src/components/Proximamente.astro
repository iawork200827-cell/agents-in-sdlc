---
// Página de espera («Muy pronto»). Se muestra mientras `enConstruccion` sea true
// en src/data/negocio.ts. Todos los textos salen de `negocio` y de `espera` abajo.
import Layout from './Layout.astro';
import { negocio, linkWhatsApp } from '../data/negocio';

const espera = {
  titulo: 'Estamos preparando las llaves de tu próxima celebración.',
  texto:
    'Muy pronto podrás conocer nuestras casas, revisar las fechas libres y cotizar tu evento en línea, todo desde tu celular.',
  /** Porcentaje que muestra la barra de «avance de obra». */
  avance: 80,
  frases: [
    'Una casa se vuelve hogar cuando se llena de momentos.',
    'Los mejores recuerdos tienen dirección.',
    'Cada fiesta merece un lugar a su medida.',
    'Abrimos puertas para que tú celebres.',
  ],
  pilares: [
    { titulo: 'Casas revisadas', texto: 'Espacios listos, limpios y seguros para tus invitados.' },
    { titulo: 'Fechas a la vista', texto: 'Consulta la disponibilidad sin esperar respuesta.' },
    { titulo: 'Trato directo', texto: 'Te acompañamos desde la visita hasta la entrega de llaves.' },
  ],
};
---

<Layout titulo="Muy pronto" descripcion={`${negocio.nombre}: ${negocio.descripcion.toLowerCase()}. Muy pronto en línea.`} sencilla>
  <main class="espera">
    <div class="wrap espera-grid">
      <div class="texto">
        <p class="marca">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7M5 10v10h14V10M10 20v-6h4v6" /></svg>
          {negocio.nombre}
        </p>
        <p class="kicker">Muy pronto · {negocio.descripcion}</p>
        <h1>{espera.titulo}</h1>
        <p class="lead">{espera.texto}</p>

        <div class="obra" role="group" aria-label="Avance del sitio">
          <div class="obra-top"><span>Avance de obra</span><strong>{espera.avance}%</strong></div>
          <div class="barra"><span style={`width: ${espera.avance}%`}></span></div>
        </div>

        <div class="acciones">
          <a class="btn" href={linkWhatsApp('Hola, vi su página. Quiero información sobre las casas para eventos.')} target="_blank" rel="noopener">
            Escríbenos por WhatsApp
          </a>
          <a class="btn btn-claro" href={`mailto:${negocio.email}`}>Enviar correo</a>
        </div>

        <div class="redes">
          <a href={negocio.redes.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={negocio.redes.tiktok} target="_blank" rel="noopener">TikTok</a>
          <a href={negocio.redes.facebook} target="_blank" rel="noopener">Facebook</a>
        </div>
      </div>

      <div class="ilustracion" aria-hidden="true">
        <div class="arco arco-durazno">
          <svg class="casa" viewBox="0 0 24 24"><path d="M3 11 12 4l9 7M5 10v10h14V10M10 20v-6h4v6" /></svg>
        </div>
        <div class="arco arco-terracota">
          <svg class="llave" viewBox="0 0 64 64"><circle cx="20" cy="20" r="11" /><circle cx="20" cy="20" r="4" /><path d="M28 28 54 54M44 44l6-6M50 50l5-5" /></svg>
        </div>
        <div class="letrero">
          <span>Próxima apertura</span>
          <strong>{negocio.dominio.replace(/^https?:\/\//, '')}</strong>
        </div>
      </div>
    </div>

    <section class="pilares">
      <div class="wrap pilares-grid">
        {
          espera.pilares.map((p, i) => (
            <article>
              <span>0{i + 1}</span>
              <h2>{p.titulo}</h2>
              <p>{p.texto}</p>
            </article>
          ))
        }
      </div>
    </section>

    <p class="frase" data-frases={JSON.stringify(espera.frases)} aria-live="polite">“{espera.frases[0]}”</p>
  </main>
</Layout>

<script>
  // Cambia la frase inmobiliaria cada pocos segundos.
  const el = document.querySelector<HTMLElement>('.frase');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const frases: string[] = JSON.parse(el.dataset.frases || '[]');
    let i = 0;
    setInterval(() => {
      el.classList.add('oculta');
      setTimeout(() => {
        i = (i + 1) % frases.length;
        el.textContent = `“${frases[i]}”`;
        el.classList.remove('oculta');
      }, 400);
    }, 4500);
  }
</script>

<style>
  :global(body.sencilla) { background: var(--verde); color: #f4efe8; }
  .espera { min-height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
  .espera-grid { flex: 1; display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; padding-top: 48px; padding-bottom: 48px; }
  @media (max-width: 860px) { .espera-grid { grid-template-columns: 1fr; gap: 24px; } .ilustracion { height: 260px; max-width: 420px; } }

  .marca { display: inline-flex; align-items: center; gap: 8px; font-family: Lora, serif; font-weight: 700; font-size: 1.3rem; margin: 0 0 40px; color: #fff; }
  .marca svg { width: 26px; height: 26px; fill: none; stroke: var(--durazno); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .kicker { color: var(--durazno); }
  h1 { font-size: clamp(2.2rem, 5.2vw, 3.6rem); color: #fff; max-width: 16ch; }
  .lead { font-size: 1.12rem; opacity: 0.88; max-width: 50ch; margin: 0 0 28px; }

  .obra { max-width: 420px; margin-bottom: 28px; }
  .obra-top { display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 6px; }
  .obra-top span { text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.8; }
  .barra { height: 10px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); overflow: hidden; }
  .barra span { display: block; height: 100%; border-radius: inherit; background: repeating-linear-gradient(-45deg, var(--durazno) 0 10px, #f6d8bf 10px 20px); animation: avanza 1.4s ease-out both; }
  @keyframes avanza { from { width: 0; } }

  .acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-claro { background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.5); }
  .redes { display: flex; gap: 20px; margin-top: 24px; }
  .redes a { color: #fff; opacity: 0.8; font-size: 0.92rem; }

  .ilustracion { position: relative; height: 440px; }
  @media (max-width: 860px) { .ilustracion { height: 280px; } }
  .arco { position: absolute; border-radius: 999px 999px 18px 18px; display: grid; place-items: start center; padding-top: 18%; }
  .arco-durazno { right: 4%; bottom: 0; width: 58%; height: 92%; background: var(--durazno); }
  .arco-terracota { left: 6%; bottom: 10%; width: 46%; height: 66%; background: var(--terracota); place-items: center; padding: 0; }
  .casa { width: 34%; fill: none; stroke: var(--verde); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .llave { width: 52%; fill: none; stroke: #fff; stroke-width: 4; stroke-linecap: round; transform: rotate(-12deg); animation: balanceo 4s ease-in-out infinite; transform-origin: 30% 30%; }
  @keyframes balanceo { 50% { transform: rotate(8deg); } }
  .letrero { position: absolute; right: 0; top: 4%; background: var(--crema); color: var(--tinta); border-radius: 12px; padding: 10px 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18); transform: rotate(3deg); display: grid; }
  .letrero span { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--terracota); font-weight: 700; }
  .letrero strong { font-size: 0.95rem; }
  @media (prefers-reduced-motion: reduce) { .llave, .barra span { animation: none; } }

  .pilares { border-top: 1px solid rgba(255, 255, 255, 0.14); padding: 36px 0; }
  .pilares-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 760px) { .pilares-grid { grid-template-columns: 1fr; gap: 18px; } }
  .pilares span { font-size: 0.8rem; font-weight: 700; color: var(--durazno); }
  .pilares h2 { font-family: 'DM Sans', sans-serif; font-size: 1.1rem; color: #fff; margin: 4px 0; }
  .pilares p { margin: 0; opacity: 0.8; font-size: 0.95rem; }

  .frase { margin: 0; padding: 22px 16px 28px; text-align: center; font-family: Lora, serif; font-style: italic; font-size: 1.1rem; color: var(--durazno); transition: opacity 0.4s; }
  .frase.oculta { opacity: 0; }
</style>
