---
// Ficha de cada casa: galería, capacidad, lo que incluye, calendario y ubicación.
// Cada casa tiene su propia dirección web, que es la que abre su código QR.
import QRCode from 'qrcode';
import Layout from '../../components/Layout.astro';
import Calendario from '../../components/Calendario.astro';
import type { Casa } from '../../data/negocio';
import { casas, enConstruccion, ruta, precioCasa, dinero, linkWhatsApp, linkMapa, urlPublica } from '../../data/negocio';

export function getStaticPaths() {
  // Durante la página de espera no se publican las fichas.
  if (enConstruccion) return [];
  return casas.map((casa) => ({ params: { slug: casa.slug }, props: { casa } }));
}

const { casa } = Astro.props as { casa: Casa };
const tonos = ['verde', 'durazno', 'arena'];
const urlFicha = urlPublica(`casas/${casa.slug}/`);
const qr = await QRCode.toString(urlFicha, { type: 'svg', margin: 1, color: { dark: '#231f20', light: '#ffffff' } });
const mensaje = `Hola, me interesa ${casa.nombre} para un evento. ¿Me pueden cotizar?`;
const precio = precioCasa(casa);
---

<Layout titulo={casa.nombre} descripcion={`${casa.nombre}: ${casa.resumen} Hasta ${casa.capacidad} invitados.`}>
  <main class="wrap ficha">
    <a href={`${ruta()}#casas`} class="volver">← Todas las casas</a>

    <div class="galeria">
      {
        casa.fotos.map((f, i) => (
          <figure class={`g g${i} ${f.src ? '' : `tono-${tonos[(tonos.indexOf(casa.color) + i) % 3]}`}`}>
            {f.src && (
              <a href={f.src} target="_blank" rel="noopener">
                <img src={f.src} alt={`${casa.nombre}: ${f.etiqueta}`} loading={i < 3 ? 'eager' : 'lazy'} />
              </a>
            )}
            <figcaption>{f.etiqueta}</figcaption>
          </figure>
        ))
      }
    </div>

    <div class="ficha-grid">
      <div>
        {casa.insignia && <p class="kicker">{casa.insignia}</p>}
        <h1>{casa.nombre}</h1>
        {casa.lema && <p class="lema">{casa.lema}</p>}
        <p class="muted">{casa.zona}</p>
        <ul class="chips">
          <li>Hasta {casa.capacidad} invitados</li>
          {casa.destacados.map((d) => <li>{d}</li>)}
        </ul>
        <p class="descripcion">{casa.descripcion}</p>

        {
          !!casa.tarifas?.length && (
            <>
              <h2>Tarifas</h2>
              <div class="tarifas">
                {casa.tarifas.map((t) => (
                  <article class="tarifa">
                    <h3>{t.nombre}</h3>
                    {t.nota && <p class="muted">{t.nota}</p>}
                    <dl>
                      {t.precios.map((p) => (
                        <div>
                          <dt>{p.etiqueta}</dt>
                          <dd>{dinero(p.monto)}</dd>
                        </div>
                      ))}
                    </dl>
                  </article>
                ))}
              </div>
              <p class="muted nota-precios">Precios en pesos mexicanos.</p>
            </>
          )
        }

        <h2>Qué incluye</h2>
        <ul class="incluye">{casa.incluye.map((i) => <li>{i}</li>)}</ul>

        {
          !!casa.capacidadDetalle?.length && (
            <>
              <h2>Capacidad</h2>
              <ul class="incluye">{casa.capacidadDetalle.map((c) => <li>{c}</li>)}</ul>
            </>
          )
        }

        {
          casa.video && (
            <>
              <h2>Recorrido en video</h2>
              <video class="video" src={casa.video.src} poster={casa.video.portada} controls playsinline preload="none" />
            </>
          )
        }

        <h2>Ideal para</h2>
        <ul class="chips">{casa.eventos.map((e) => <li>{e}</li>)}</ul>

        <h2>Fechas libres</h2>
        <Calendario casas={[casa]} />

        {
          casa.mapa && (
            <>
              <h2>Ubicación</h2>
              <div class="mapa">
                <iframe
                  title={`Mapa de ${casa.nombre}`}
                  src={`https://www.google.com/maps?q=${encodeURIComponent(casa.mapa)}&output=embed`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
              <a href={linkMapa(casa.mapa)} target="_blank" rel="noopener">Abrir en Google Maps →</a>
            </>
          )
        }
      </div>

      <aside class="lateral">
        <div class="caja">
          <p class="precio">{precio.antes}<strong>{precio.monto}</strong><span>{precio.despues}</span></p>
          <p class="muted">Hasta {casa.capacidad} invitados</p>
          {casa.horario && <p class="dato">{casa.horario}</p>}
          {!!casa.anticipo && <p class="dato">Aparta con <strong>{dinero(casa.anticipo)}</strong> y liquida el día de tu estancia.</p>}
          <a class="btn btn-block" href={linkWhatsApp(mensaje)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
          <a class="btn btn-borde btn-block" href={`${ruta()}#contacto`}>Formulario de cotización</a>
        </div>
        <div class="caja qr">
          <div class="qr-img" set:html={qr} />
          <p><strong>Código QR de esta casa</strong></p>
          <p class="muted">Imprímelo para la entrada o tus lonas: abre esta ficha con sus fechas libres.</p>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  .ficha { padding-top: 24px; padding-bottom: 72px; }
  .volver { display: inline-block; margin-bottom: 16px; color: var(--gris); text-decoration: none; }
  .galeria { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 170px; gap: 12px; margin-bottom: 36px; }
  .g0 { grid-column: span 2; }
  .g a { position: absolute; inset: 0; }
  .lema { font-family: Lora, serif; font-style: italic; color: var(--terracota); font-size: 1.15rem; margin: 6px 0 4px; }
  .tarifas { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .tarifa { background: var(--blanco); border: 1px solid var(--linea); border-radius: 16px; padding: 18px; }
  .tarifa h3 { font-family: 'DM Sans', sans-serif; font-size: 1.05rem; margin: 0 0 2px; }
  .tarifa > p { margin: 0 0 10px; font-size: 0.85rem; }
  .tarifa dl { margin: 0; display: grid; gap: 6px; }
  .tarifa dl div { display: flex; justify-content: space-between; gap: 10px; border-top: 1px solid var(--linea); padding-top: 6px; }
  .tarifa dt { font-size: 0.92rem; }
  .tarifa dd { margin: 0; font-weight: 700; color: var(--terracota); }
  .nota-precios { font-size: 0.82rem; margin-top: 8px; }
  .video { width: 100%; max-width: 360px; aspect-ratio: 9 / 16; border-radius: 18px; background: #000; display: block; }
  .dato { font-size: 0.92rem; }
  .g { margin: 0; position: relative; border-radius: 18px; overflow: hidden; display: flex; align-items: flex-end; padding: 14px; font-size: 0.9rem; }
  .g img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .g figcaption { position: relative; }
  .g a + figcaption { background: rgba(0,0,0,0.45); color: #fff; padding: 2px 10px; border-radius: 999px; }
  .g0 { grid-row: span 2; }
  @media (max-width: 640px) { .galeria { grid-template-columns: 1fr 1fr; grid-auto-rows: 130px; } .g0 { grid-column: 1 / -1; grid-row: span 2; } }

  .ficha-grid { display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start; }
  @media (max-width: 900px) { .ficha-grid { grid-template-columns: 1fr; } }
  .ficha h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0; }
  .ficha h2 { font-size: 1.4rem; margin: 36px 0 14px; }
  .descripcion { font-size: 1.08rem; margin-top: 18px; }
  .incluye { padding: 0; margin: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  .incluye li::before { content: '✓ '; color: var(--verde); font-weight: 700; }
  .mapa { border-radius: 18px; overflow: hidden; border: 1px solid var(--linea); aspect-ratio: 16 / 9; margin-bottom: 8px; }
  .mapa iframe { width: 100%; height: 100%; border: 0; }

  .lateral { position: sticky; top: 92px; display: grid; gap: 16px; }
  .caja { background: var(--blanco); border: 1px solid var(--linea); border-radius: 18px; padding: 22px; display: grid; gap: 10px; }
  .caja p { margin: 0; }
  .precio strong { font-size: 1.6rem; font-family: Lora, serif; }
  .precio span { color: var(--gris); }
  .qr { text-align: center; }
  .qr-img { width: 160px; margin: 0 auto; }
  .qr-img :global(svg) { width: 100%; height: auto; display: block; }
  .qr .muted { font-size: 0.85rem; }
</style>
